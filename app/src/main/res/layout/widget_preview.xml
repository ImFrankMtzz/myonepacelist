<?xml version="1.0" encoding="utf-8"?>
<!-- Static preview shown in the widget picker (Android 12+). Mirrors NextEpisodeWidget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SIGUIENTE"
        android:textColor="#FFF4B740"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:text="Bell-mère-san"
        android:textColor="#FFE8ECF1"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Arlong Park · 04"
        android:textColor="#FF9AA4B2"
        android:textSize="12sp" />

    <!-- RemoteViews only allow a fixed set of views: ImageView, not a plain View. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_preview_track" />
</LinearLayout>
